#!/usr/bin/env python3
"""Create a deterministic OpenClaw configuration for one benchmark container.

Required:
  OPENCLAW_MODEL       Model selector, normally provider/model-id.
  MODEL_API_KEY        Runtime credential exposed to OpenClaw through SecretRef.

Optional generic-provider overrides:
  OPENCLAW_PROVIDER    Provider key used in models.providers and the primary id.
  OPENCLAW_MODEL_ID    Provider-native model id. Useful when it contains slashes.
  OPENCLAW_BASE_URL    Provider API base URL. Required for unknown providers.
  OPENCLAW_API         OpenClaw request adapter, such as openai-completions,
                       openai-responses, anthropic-messages, or google-generative-ai.

Ofox routes remain supported for backward compatibility.
"""
from __future__ import annotations

import json
import os
import subprocess
import sys
from pathlib import Path

CONFIG_PATH = Path.home() / ".openclaw" / "openclaw.json"
WORKSPACE_PATH = "/root/.openclaw/workspace"

OFOX_OPENAI_PROVIDER = "ofox-openai"
OFOX_ANTHROPIC_PROVIDER = "ofox-anthropic"
OFOX_GEMINI_PROVIDER = "ofox-gemini"

OFOX_V1_BASE = "https://api.ofox.io/v1"
OFOX_ANTHROPIC_BASE = "https://api.ofox.io/anthropic"
OFOX_GEMINI_BASE = "https://api.ofox.io/gemini"

OFOX_V1_MODEL_IDS = [
    "openai/gpt-5.4",
    "openai/gpt-5.2",
    "z-ai/glm-5-turbo",
    "moonshotai/kimi-k2.5",
    "volcengine/doubao-seed-2.0-pro",
    "bailian/qwen3.6-plus",
    "bailian/qwen3.5-plus",
    "minimax/minimax-m2.7",
    "deepseek/deepseek-v3.2",
]
OFOX_ANTHROPIC_MODEL_IDS = [
    "anthropic/claude-sonnet-4.6",
    "anthropic/claude-opus-4.6",
    "anthropic/claude-opus-4.7",
]
OFOX_GEMINI_MODEL_IDS = [
    "google/gemini-3.1-pro-preview",
]

PROVIDER_DEFAULTS = {
    "moonshot": ("https://api.moonshot.cn/v1", "openai-completions"),
    "modelstudio": ("https://dashscope.aliyuncs.com/compatible-mode/v1", "openai-completions"),
    "openrouter": ("https://openrouter.ai/api/v1", "openai-completions"),
    "anthropic": ("https://api.anthropic.com", "anthropic-messages"),
    "openai": ("https://api.openai.com/v1", "openai-responses"),
    "deepseek": ("https://api.deepseek.com/v1", "openai-completions"),
    "google": ("https://generativelanguage.googleapis.com/v1beta", "google-generative-ai"),
    "gemini": ("https://generativelanguage.googleapis.com/v1beta", "google-generative-ai"),
}


def fail(message: str) -> None:
    print(f"[openclaw-init] ERROR: {message}", file=sys.stderr, flush=True)
    raise SystemExit(1)


def human_name(model_id: str) -> str:
    tail = model_id.split("/")[-1]
    return " ".join(word.capitalize() for word in tail.replace("-", " ").replace(".", " ").split())


def model_specs(ids: list[str]) -> list[dict]:
    return [{"id": model_id, "name": human_name(model_id)} for model_id in ids]


def secret_ref() -> dict[str, str]:
    return {"source": "env", "provider": "default", "id": "MODEL_API_KEY"}


def provider_block(base_url: str, api: str, models: list[dict], has_api_key: bool) -> dict:
    block = {
        "baseUrl": base_url,
        "api": api,
        "models": models,
    }
    if has_api_key:
        block["apiKey"] = secret_ref()
    return block


def primary_for_ofox(model: str) -> tuple[str, str] | None:
    for prefix, provider, model_ids in (
        (f"{OFOX_OPENAI_PROVIDER}/", OFOX_OPENAI_PROVIDER, OFOX_V1_MODEL_IDS),
        (f"{OFOX_ANTHROPIC_PROVIDER}/", OFOX_ANTHROPIC_PROVIDER, OFOX_ANTHROPIC_MODEL_IDS),
        (f"{OFOX_GEMINI_PROVIDER}/", OFOX_GEMINI_PROVIDER, OFOX_GEMINI_MODEL_IDS),
    ):
        if model.startswith(prefix):
            model_id = model[len(prefix):].lstrip("/")
            if model_id in model_ids:
                return provider, model_id
    if model in OFOX_V1_MODEL_IDS:
        return OFOX_OPENAI_PROVIDER, model
    if model in OFOX_ANTHROPIC_MODEL_IDS:
        return OFOX_ANTHROPIC_PROVIDER, model
    if model in OFOX_GEMINI_MODEL_IDS:
        return OFOX_GEMINI_PROVIDER, model
    return None


def build_ofox_providers(has_api_key: bool, anthropic_api: str) -> dict[str, dict]:
    return {
        OFOX_OPENAI_PROVIDER: provider_block(
            OFOX_V1_BASE, "openai-completions", model_specs(OFOX_V1_MODEL_IDS), has_api_key
        ),
        OFOX_ANTHROPIC_PROVIDER: provider_block(
            OFOX_ANTHROPIC_BASE, anthropic_api, model_specs(OFOX_ANTHROPIC_MODEL_IDS), has_api_key
        ),
        OFOX_GEMINI_PROVIDER: provider_block(
            OFOX_GEMINI_BASE, "openai-completions", model_specs(OFOX_GEMINI_MODEL_IDS), has_api_key
        ),
    }


def parse_llm_params() -> dict[str, float | int]:
    params: dict[str, float | int] = {}
    for env_name, config_name, cast in (
        ("TEMPERATURE", "temperature", float),
        ("TOP_P", "topP", float),
        ("MAX_TOKENS", "maxTokens", int),
    ):
        raw = os.environ.get(env_name, "").strip()
        if not raw:
            continue
        try:
            params[config_name] = cast(raw)
        except ValueError:
            fail(f"invalid {env_name}={raw!r}")
    return params


def resolve_generic_model(model: str) -> tuple[str, str, str, str]:
    provider_override = os.environ.get("OPENCLAW_PROVIDER", "").strip()
    model_id_override = os.environ.get("OPENCLAW_MODEL_ID", "").strip()
    base_url_override = os.environ.get("OPENCLAW_BASE_URL", "").strip().rstrip("/")
    api_override = os.environ.get("OPENCLAW_API", "").strip()

    if provider_override:
        provider = provider_override
        if model_id_override:
            model_id = model_id_override
        elif model.startswith(f"{provider}/"):
            model_id = model[len(provider) + 1:]
        else:
            model_id = model
    else:
        if "/" not in model:
            fail("model must be provider/model-id, or OPENCLAW_PROVIDER must be set")
        provider, model_id = model.split("/", 1)
        if model_id_override:
            model_id = model_id_override

    default_base_url, default_api = PROVIDER_DEFAULTS.get(provider, ("", "openai-completions"))
    base_url = base_url_override or default_base_url
    api = api_override or default_api
    if not base_url:
        fail(f"unknown provider {provider!r}; set OPENCLAW_BASE_URL and optionally OPENCLAW_API")
    if not model_id:
        fail("resolved model id is empty")
    return provider, model_id, base_url, api


def main() -> None:
    model = os.environ.get("OPENCLAW_MODEL", "").strip()
    if not model:
        fail("OPENCLAW_MODEL not set")
    has_api_key = bool(os.environ.get("MODEL_API_KEY", "").strip())
    anthropic_api = os.environ.get("OFOX_ANTHROPIC_API", "anthropic-messages").strip()
    if anthropic_api not in {"anthropic-messages", "openai-completions"}:
        fail("OFOX_ANTHROPIC_API must be anthropic-messages or openai-completions")

    try:
        subprocess.run(
            ["git", "config", "--global", "--add", "safe.directory", "*"],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except OSError:
        pass

    explicit_generic_config = any(
        os.environ.get(name, "").strip()
        for name in ("OPENCLAW_PROVIDER", "OPENCLAW_MODEL_ID", "OPENCLAW_BASE_URL", "OPENCLAW_API")
    )
    ofox = None if explicit_generic_config else primary_for_ofox(model)
    if ofox is not None:
        provider, model_id = ofox
        primary = f"{provider}/{model_id}"
        providers = build_ofox_providers(has_api_key, anthropic_api)
    else:
        provider, model_id, base_url, api = resolve_generic_model(model)
        primary = f"{provider}/{model_id}"
        providers = {
            provider: provider_block(
                base_url,
                api,
                [{"id": model_id, "name": human_name(model_id)}],
                has_api_key,
            )
        }

    params = parse_llm_params()
    agent_defaults: dict = {
        "workspace": WORKSPACE_PATH,
        "model": {"primary": primary},
    }
    if params:
        agent_defaults["models"] = {
            primary: {"alias": human_name(model_id), "params": params}
        }

    config = {
        "gateway": {
            "mode": "local",
            "bind": "loopback",
            "auth": {
                "mode": "token",
                "token": "${OPENCLAW_GATEWAY_TOKEN}",
            },
        },
        "agents": {"defaults": agent_defaults},
        "models": {
            "mode": "replace",
            "providers": providers,
        },
        "tools": {
            "profile": "coding",
            "exec": {"security": "full", "ask": "off"},
        },
    }

    CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
    CONFIG_PATH.write_text(json.dumps(config, indent=2) + "\n", encoding="utf-8")
    CONFIG_PATH.chmod(0o600)
    print(
        f"[openclaw-init] primary={primary} provider={provider} "
        f"api={providers[provider]['api']} key={'env-ref' if has_api_key else 'NOT SET'}",
        flush=True,
    )


if __name__ == "__main__":
    main()
